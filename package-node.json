{
  "name": "drms-mcp-server-node",
  "version": "1.2.8",
  "description": "Documentation RAG MCP Server - Node.js/TypeScript implementation for real-time documentation access",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "drms-node": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "api": "node dist/api.js",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "watch": "tsc --watch",
    "cli": "tsx src/cli.ts",
    "demo": "tsx src/examples/demo-search.ts"
  },
  "keywords": [
    "mcp",
    "documentation",
    "rag",
    "ai",
    "coding",
    "assistant",
    "vector-search",
    "embeddings",
    "real-time",
    "library-docs",
    "typescript",
    "nodejs"
  ],
  "author": {
    "name": "DRMS Team",
    "url": "https://www.linkedin.com/in/irenicj/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "chromadb": "^1.8.1",
    "commander": "^11.1.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "openai": "^4.52.0",
    "p-limit": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pate0304/DRMS.git"
  },
  "homepage": "https://github.com/pate0304/DRMS#readme",
  "bugs": {
    "url": "https://github.com/pate0304/DRMS/issues"
  }
}